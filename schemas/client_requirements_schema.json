{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientRentalRequirements",
  "description": "Client rental requirements schema for finding an apartment in Poland with strictness flags for conditions",
  "type": "object",
  "properties": {
    "property_requirements": {
      "type": "object",
      "title": "Property requirements",
      "properties": {
        "min_area_sqm": {
          "type": "object",
          "properties": {
            "value": { "type": ["number", "null"], "minimum": 0, "description": "Minimum area (sqm)" },
            "is_strict_requirement": { "type": "boolean", "default": false, "description": "Is the requirement strict" }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "min_functional_requirements": {
          "type": "object",
          "properties": {
            "value": { "type": ["string", "null"], "description": "Minimum functionality (workspace, walk-in closet)" },
            "is_strict_requirement": { "type": "boolean", "default": false, "description": "Is the requirement strict" }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "rooms_count": {
          "type": "object",
          "properties": {
            "value": { "type": ["integer", "null"], "minimum": 1, "description": "Number of rooms" },
            "is_strict_requirement": { "type": "boolean", "default": false, "description": "Is the requirement strict" }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "kitchen_type": {
          "type": "object",
          "properties": {
            "value": {
              "type": ["string", "null"],
              "enum": ["Separate", "OpenPlan", "Kitchenette", "Any", null],
              "description": "Kitchen type"
            },
            "is_strict_requirement": { "type": "boolean", "default": false, "description": "Is the requirement strict" }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "building_disqualifiers": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Building disqualification criteria"
            },
            "is_strict_requirement": { "type": "boolean", "default": false, "description": "Is the requirement strict" }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "additional_preferences": {
          "type": "object",
          "properties": {
            "floor_preferences": {
              "type": "object",
              "properties": {
                "value": {
                  "type": ["object", "null"],
                  "description": "Structured floor preferences",
                  "properties": {
                    "min_floor": { "type": ["integer", "null"] },
                    "max_floor": { "type": ["integer", "null"] },
                    "excluded_floors": {
                      "type": "array",
                      "items": { "type": "integer" },
                      "default": []
                    }
                  }
                },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "design_style": {
              "type": "object",
              "properties": {
                "value": { "type": ["string", "null"], "description": "Design / finish" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "has_balcony": {
              "type": "object",
              "properties": {
                "value": { "type": ["boolean", "null"], "description": "Presence of a balcony/terrace" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "other": {
              "type": "object",
              "properties": {
                "value": { "type": ["string", "null"], "description": "Other preferences" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            }
          }
        },
        "current_apartment_feedback": {
          "type": "object",
          "description": "Feedback on current housing",
          "properties": {
            "liked": { "type": ["string", "null"], "description": "What is liked" },
            "disliked": { "type": ["string", "null"], "description": "What is disliked" }
          }
        }
      },
      "required": ["rooms_count"]
    },
    "location": {
      "type": "object",
      "title": "Location and transportation",
      "properties": {
        "anchor_points": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Anchor points in the city"
            },
            "is_strict_requirement": { "type": "boolean", "default": false }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "transportation_type": {
          "type": "object",
          "properties": {
            "value": { "type": ["string", "null"], "description": "Transportation type" },
            "is_strict_requirement": { "type": "boolean", "default": false }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "commute": {
          "type": "object",
          "properties": {
            "optimal_time_minutes": {
              "type": "object",
              "properties": {
                "value": { "type": ["integer", "null"], "description": "Optimal commute time (min)" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "max_time_minutes": {
              "type": "object",
              "properties": {
                "value": { "type": ["integer", "null"], "description": "Maximum commute time (min)" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "max_distance_km": {
              "type": "object",
              "properties": {
                "value": { "type": ["number", "null"], "description": "Maximum distance (km)" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            }
          }
        },
        "infrastructure_preferences": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Infrastructure preferences"
            },
            "is_strict_requirement": { "type": "boolean", "default": false }
          },
          "required": ["value", "is_strict_requirement"]
        }
      }
    },
    "personal_situation": {
      "type": "object",
      "title": "Personal situation and finances",
      "properties": {
        "tenants_profile": {
          "type": "object",
          "properties": {
            "adults_count": { "type": "integer", "minimum": 1, "description": "Number of adults" },
            "children_count": { "type": "integer", "minimum": 0, "description": "Number of children" },
            "pets": {
              "type": "object",
              "properties": {
                "value": { "type": ["string", "null"], "description": "Pets" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "details": { "type": ["string", "null"], "description": "Tenant composition / details" }
          },
          "required": ["adults_count"]
        },
        "current_housing_status": {
          "type": ["string", "null"],
          "description": "Current housing situation"
        },
        "lease_period_expectations": {
          "type": "object",
          "properties": {
            "value": { "type": ["string", "null"], "description": "Lease period expectations" },
            "is_strict_requirement": { "type": "boolean", "default": false }
          },
          "required": ["value", "is_strict_requirement"]
        },
        "financial_situation": {
          "type": "object",
          "properties": {
            "occupations": { "type": ["string", "null"], "description": "Occupations / fields of activity" },
            "employed_tenants_info": { "type": ["string", "null"], "description": "Who exactly is employed" },
            "income_proof_documents": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Income proof documents"
            }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_total_budget_pln": {
              "type": "object",
              "properties": {
                "value": { "type": ["number", "null"], "description": "Maximum budget (PLN)" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "base_rent_pln": {
              "type": "object",
              "properties": {
                "value": { "type": ["number", "null"], "description": "Base rent without fees (PLN)" },
                "is_strict_requirement": { "type": "boolean", "default": false }
              },
              "required": ["value", "is_strict_requirement"]
            },
            "includes_admin_fees": { "type": ["boolean", "null"], "description": "Does the budget include admin fees (czynsz)" }
          },
          "required": ["max_total_budget_pln"]
        }
      },
      "required": ["tenants_profile", "budget"]
    },
    "summary": {
      "type": "string",
      "description": "Summary and key takeaways from the client's request"
    }
  },
  "required": ["property_requirements", "location", "personal_situation"]
}
